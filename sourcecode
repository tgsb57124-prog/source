    local DasHoodCfg = Config['Das Hood'];
    local InfRangeCfg = DasHoodCfg['Inf Range'];
    local WallbangCfg = DasHoodCfg['Wallbang'];
    
    if InfRangeCfg['Enabled'] then
        task.spawn(function()
            local MainEvent = ReplicatedStorage:FindFirstChild('MainEvent') or ReplicatedStorage:WaitForChild('MainEvent', 10);
            if MainEvent then
                -- Inf Range: Set all gun ranges to 999999
                table.insert(getgenv().LiquidConnections, RunService.Heartbeat:Connect(function()
                    local Character = LocalPlayer.Character;
                    if Character then
                        for _, Tool in next, Character:GetChildren() do
                            if Tool:IsA('Tool') then
                                local R = Tool:FindFirstChild('Range');
                                if R then R.Value = 999999 end;
                            end;
                        end;
                    end;
                    local Backpack = LocalPlayer:FindFirstChild('Backpack');
                    if Backpack then
                        for _, Tool in next, Backpack:GetChildren() do
                            if Tool:IsA('Tool') then
                                local R = Tool:FindFirstChild('Range');
                                if R then R.Value = 999999 end;
                            end;
                        end;
                    end;
                end));
                
                -- Hook MainEvent to modify ShootGun calls
                local hookMM = hookmetamethod or (getgenv and getgenv().hookmetamethod);
                if hookMM then
                    local oldNC;
                    oldNC = hookMM(game, '__namecall', function(self, ...)
                        local method = getnamecallmethod();
                        local args = {...};
                        if self == MainEvent and method == 'FireServer' and args[1] == 'ShootGun' then
                            if args[6] and type(args[6]) == 'number' then
                                args[6] = 10;
                            end;
                            if args[3] and args[5] then
                                local Dir = (args[3] - args[5]).Unit;
                                args[3] = args[5] + Dir * 10;
                            end;
                        end;
                        if args[1] == 'CHECKER_4' then return nil end;
                        return oldNC(self, unpack(args));
                    end);
                end;
            end;
        end);
    end;
    
    if WallbangCfg['Enabled'] then
        local function DoWallbang()
            local IgnoredFolder = Workspace:FindFirstChild('Ignored');
            if not IgnoredFolder then
                IgnoredFolder = Instance.new('Folder');
                IgnoredFolder.Name = 'Ignored';
                IgnoredFolder.Parent = Workspace;
            end;
            local Map = Workspace:FindFirstChild('MAP') or Workspace:FindFirstChild('Map');
            if Map and Map.Parent ~= IgnoredFolder then
                Map.Parent = IgnoredFolder;
            end;
        end;
        DoWallbang();
        table.insert(getgenv().LiquidConnections, RunService.Heartbeat:Connect(function()
            if Config['Das Hood']['Wallbang']['Enabled'] then
                DoWallbang();
            end;
        end));
    end;
end;

-- Delay Changer (from armir.lua - exact code)
local function ApplyDelayModification(Tool)
    local weaponName = Tool.Name;
    local delaySettings = Config['Das Hood']['Delay Changer'];
    
    if not delaySettings or not delaySettings['Enabled'] then
        return;
    end;
    
    local Delay = delaySettings['Weapons'][weaponName];
    if Delay == nil then
        return;
    end;
    
    for Index, Connection in pairs(getconnections(Tool.Activated)) do
        local Info = debug.getinfo(Connection.Function);
        for i = 1, Info.nups do
            local c, n = debug.getupvalue(Connection.Function, i);
            if type(c) == "number" then 
                debug.setupvalue(Connection.Function, i, Delay);
            end;
        end;
    end;
end;

-- Spread Modifier (from armir - exact code)
do
    -- Get GunHandler from ReplicatedStorage
    local ReplicatedStorage = game:GetService('ReplicatedStorage');
    local GunHandler = nil;
    local OriginalGetAim = nil;
    local oldShoot = nil;
    
    -- Try to find GunHandler
    local modules = ReplicatedStorage:FindFirstChild("Modules");
    if modules then
        GunHandler = modules:FindFirstChild("GunHandler");
        if GunHandler then
            GunHandler = require(GunHandler);
        end;
    end;
    
    if not GunHandler then
        local combat = ReplicatedStorage:FindFirstChild("Combat");
        if combat then
            GunHandler = combat:FindFirstChild("GunHandler");
            if GunHandler then
                GunHandler = require(GunHandler);
            end;
        end;
    end;
    
    if not GunHandler then
        local weapons = ReplicatedStorage:FindFirstChild("Weapons");
        if weapons then
            GunHandler = weapons:FindFirstChild("GunHandler");
            if GunHandler then
                GunHandler = require(GunHandler);
            end;
        end;
    end;
    
    -- Fallback if GunHandler not found
    if not GunHandler then
        GunHandler = {
            getAim = function(Origin, MaxDistance)
                return Vector3New(1,0,0), MaxDistance or 200;
            end,
            shoot = function(data)
                return nil;
            end
        };
    end;
    
    OriginalGetAim = GunHandler.getAim;
    oldShoot = GunHandler.shoot;
    
    local function getCurrentWeaponName()
        local character = LocalPlayer.Character;
        if not character then
            return nil;
        end;
        local tool = character:FindFirstChildOfClass("Tool");
        if tool then
            return tool.Name;
        end;
        return nil;
    end;
    
    GunHandler.shoot = function(data)
        local spreadConfig = Config['Das Hood']['Spread Modifier'];
        local isSpreadEnabled = spreadConfig['Enabled'];
        
        if isSpreadEnabled then
            local weaponName = getCurrentWeaponName();
            if weaponName and spreadConfig['Weapons'][weaponName] ~= nil then
                local spreadAmount = spreadConfig['Weapons'][weaponName];
                spreadAmount = MathClamp(spreadAmount, 0, 1);
                
                local origin = data.ForcedOrigin;
                local range = data.Range or 200;
                if origin and data.AimPosition then
                    local cleanDirection = GunHandler.getAim(origin, range);
                    local spreadDirection = (data.AimPosition - origin).Unit;
                    local finalDirection = spreadDirection:Lerp(
                        cleanDirection,
                        1 - spreadAmount
                    ).Unit;
                    data.AimPosition = origin + (finalDirection * range);
                end;
            end;
        end;
        
        return oldShoot(data);
    end;
end;

-- Movement Features (Anti Trip, No Jump Cooldown, Speed from armir, Jump from cidir new)
do
    local EnumFallingDown = Enum.HumanoidStateType.FallingDown;
    local EnumRagdoll = Enum.HumanoidStateType.Ragdoll;
    local EnumGettingUp = Enum.HumanoidStateType.GettingUp;
    local EnumAir = Enum.Material.Air;
    local EnumJumping = Enum.HumanoidStateType.Jumping;
    local EnumFreefall = Enum.HumanoidStateType.Freefall;
    local EnumLanded = Enum.HumanoidStateType.Landed;
    local RaycastParamsNew = RaycastParams.new;
    local EnumExclude = Enum.RaycastFilterType.Exclude;
    
    -- Get Movement Key for Jump (used by Jump Modifications)
    local function GetMovementKey(Character, Humanoid, Cfg)
        if not Character or not Humanoid then return 'Normal' end;
        
        local Tool = Character:FindFirstChildOfClass('Tool');
        local IsKnife = Tool and Tool.Name == '[Knife]';
        local IsReload = false;
        
        if Tool then
            local Ammo = Tool:FindFirstChild('Ammo');
            if Ammo and Ammo.Value == 0 then IsReload = true end;
            if not IsReload then
                local Reloading = Tool:FindFirstChild('Reloading');
                if Reloading and Reloading.Value then IsReload = true end;
            end;
        end;
        
        local Threshold = 25;
        local IsLowHealth = Humanoid and Humanoid.Health > 0 and Humanoid.Health <= Threshold;
        local Desired = 'Normal';
        
        if IsKnife then
            Desired = 'Knife';
        elseif IsLowHealth then
            Desired = 'Low Health';
        elseif IsReload then
            Desired = 'Reload';
        elseif State.IsShooting then
            Desired = 'Shooting';
        end;
        
        local Conditions = (Cfg and Cfg['Conditions']) or {};
        local Entry = Conditions[Desired];
        if Entry and Entry['Enabled'] == false then
            return 'Normal';
        end;
        return Desired;
    end;
    
    -- Anti Trip
    local function SetupAntiFall(Character)
        if not Character then return end;
        local Humanoid = Character:FindFirstChildOfClass('Humanoid') or Character:WaitForChild('Humanoid', 10);
        if not Humanoid then return end;
        table.insert(getgenv().LiquidConnections, Humanoid.StateChanged:Connect(function(_, NewState)
            if not Config['Movement']['Anti Trip'] then return end;
            if NewState == EnumFallingDown or NewState == EnumRagdoll then
                Humanoid:ChangeState(EnumGettingUp);
            end;
        end));
    end;
    
    if LocalPlayer.Character then SetupAntiFall(LocalPlayer.Character) end;
    table.insert(getgenv().LiquidConnections, LocalPlayer.CharacterAdded:Connect(SetupAntiFall));
    
    -- No Jump Cooldown
    local function SetupNoJumpCooldown(Character)
        if not Character then return end;
        local Humanoid = Character:FindFirstChildOfClass('Humanoid');
        if not Humanoid then return end;
        local DefaultJumpPower = Humanoid.JumpPower;
        table.insert(getgenv().LiquidConnections, Humanoid:GetPropertyChangedSignal('JumpPower'):Connect(function()
            if not Config['Movement']['No Jump Cooldown'] then return end;
            if Humanoid.JumpPower == 0 then
                local JumpModCfg = Config['Jump Modifications'];
                if JumpModCfg['Enabled'] and State.JumpModificationsActive and not JumpModCfg['Spiderman Mode'] then
                    local Key = GetMovementKey(Character, Humanoid, JumpModCfg);
                    local Conditions = JumpModCfg['Conditions'] or {};
                    local Entry = Conditions[Key];
                    local Mult = (Entry and Entry['Enabled'] ~= false and Entry['Multiplier']) or 1;
                    local Multiplier = JumpModCfg['Multiplier'] or 1;
                    Humanoid.JumpPower = (Multiplier * 100) * Mult;
                else
                    Humanoid.JumpPower = DefaultJumpPower;
                end;
            end;
        end));
    end;
    
    if LocalPlayer.Character then SetupNoJumpCooldown(LocalPlayer.Character) end;
    table.insert(getgenv().LiquidConnections, LocalPlayer.CharacterAdded:Connect(SetupNoJumpCooldown));
    
    -- WalkSpeed from armir (exact code)
    local function SetupWalkSpeed(Character)
        if not Character then return end;
        local Humanoid = Character:FindFirstChildOfClass('Humanoid') or Character:WaitForChild('Humanoid', 10);
        if not Humanoid then return end;
        
        table.insert(getgenv().LiquidConnections, RunService.RenderStepped:Connect(function()
            if not Character.Parent then return end;
            local MovementSettings = Config['Movement Modifications'];
            if not MovementSettings or not MovementSettings['Enabled'] or not State.WalkSpeedActive then return end;
            
            local Tool = Character:FindFirstChildOfClass('Tool');
            local IsReload = false;
            if Tool then
                local Ammo = Tool:FindFirstChild('Ammo');
                if Ammo and Ammo.Value == 0 then IsReload = true end;
                if not IsReload then
                    local Reloading = Tool:FindFirstChild('Reloading');
                    if Reloading and Reloading.Value then IsReload = true end;
                end;
            end;
            
            local IsLowHealth = Humanoid.Health > 0 and Humanoid.Health <= 25;
            local Key = '[Normal]';
            if IsLowHealth then
                Key = '[Low-Health]';
            elseif IsReload then
                Key = '[Reloading]';
            elseif State.IsShooting then
                Key = '[Shooting]';
            end;
            
            local SpeedValue = tonumber(MovementSettings['Conditions'][Key]) or tonumber(MovementSettings['Conditions']['[Normal]']) or 16;
            local Multiplier = MovementSettings['Multiplier'] or 1;
            Humanoid.WalkSpeed = SpeedValue * Multiplier;
        end));
    end;
    
    if LocalPlayer.Character then SetupWalkSpeed(LocalPlayer.Character) end;
    table.insert(getgenv().LiquidConnections, LocalPlayer.CharacterAdded:Connect(SetupWalkSpeed));
    
    -- Jump Modifications from cidir new (exact code)
    local function SetupJumpModifications(Character)
        if not Character then return end;
        local Humanoid = Character:FindFirstChildOfClass('Humanoid') or Character:WaitForChild('Humanoid', 10);
        if not Humanoid then return end;
        local DefaultJumpPower = Humanoid.JumpPower;
        
        local WallCheckParams = RaycastParamsNew();
        WallCheckParams.FilterType = EnumExclude;
        WallCheckParams.FilterDescendantsInstances = {Character};
        
        local function IsNearWall(RootPart)
            local Origin = RootPart.Position;
            local CF = RootPart.CFrame;
            local Directions = { CF.LookVector, -CF.LookVector, CF.RightVector, -CF.RightVector, (CF.LookVector + CF.RightVector).Unit, (CF.LookVector - CF.RightVector).Unit, (-CF.LookVector + CF.RightVector).Unit, (-CF.LookVector - CF.RightVector).Unit };
            for _, Dir in next, Directions do
                if Workspace:Raycast(Origin, Dir * 5, WallCheckParams) then return true end;
            end;
            return false;
        end;
        
        local function GetJumpValue()
            local JumpModCfg = Config['Jump Modifications'];
            
            -- If Spiderman Mode, use Spider Value directly (no multiplier or conditions)
            if JumpModCfg['Spiderman Mode'] then
                return JumpModCfg['Spider Value'] or 75;
            end;
            
            -- Normal mode: use Multiplier with Conditions
            local Key = GetMovementKey(Character, Humanoid, JumpModCfg);
            local Conditions = JumpModCfg['Conditions'] or {};
            local Entry = Conditions[Key];
            local Mult = (Entry and Entry['Enabled'] ~= false and Entry['Multiplier']) or 1;
            local Multiplier = JumpModCfg['Multiplier'] or 1;
            return (Multiplier * 100) * Mult;
        end;
        
        local JumpConn;
        local JumpWasBoosted = false;
        JumpConn = RunService.RenderStepped:Connect(function()
            if not Character.Parent then JumpConn:Disconnect(); return end;
            local JumpModCfg = Config['Jump Modifications'];
            
            -- If Spiderman Mode, don't continuously boost (only on wall jumps)
            if JumpModCfg['Spiderman Mode'] then
                if JumpWasBoosted then
                    Humanoid.JumpPower = DefaultJumpPower;
                    JumpWasBoosted = false;
                end;
                return;
            end;
            
            -- Normal mode: continuously apply jump boost
            if not JumpModCfg['Enabled'] or not State.JumpModificationsActive then
                if JumpWasBoosted then
                    Humanoid.JumpPower = DefaultJumpPower;
                    JumpWasBoosted = false;
                end;
                return;
            end;
            Humanoid.UseJumpPower = true;
            Humanoid.JumpPower = GetJumpValue();
            JumpWasBoosted = true;
        end);
        table.insert(getgenv().LiquidConnections, JumpConn);
        
        local RequestConn;
        local LastWallJump = 0;
        RequestConn = UserInputService.JumpRequest:Connect(function()
            if not Character.Parent then RequestConn:Disconnect(); return end;
            local JumpModCfg = Config['Jump Modifications'];
            if not JumpModCfg['Enabled'] or not State.JumpModificationsActive or not JumpModCfg['Spiderman Mode'] then return end;
            local RootPart = Character:FindFirstChild('HumanoidRootPart');
            if not RootPart then return end;
            if Humanoid.FloorMaterial ~= EnumAir then return end;
            if (Clock() - LastWallJump) < 0.3 then return end;
            if not IsNearWall(RootPart) then return end;
            LastWallJump = Clock();
            Humanoid.UseJumpPower = true;
            Humanoid.JumpPower = JumpModCfg['Spider Value'] or 75;  -- Use Spider Value for wall jumps
            Humanoid:ChangeState(EnumJumping);
            local ResetConn;
            ResetConn = Humanoid.StateChanged:Connect(function(_, NewState)
                if NewState == EnumFreefall or NewState == EnumLanded then
                    ResetConn:Disconnect();
                    Humanoid.JumpPower = DefaultJumpPower;
                end;
            end);
            table.insert(getgenv().LiquidConnections, ResetConn);
        end);
        table.insert(getgenv().LiquidConnections, RequestConn);
    end;
    
    if LocalPlayer.Character then SetupJumpModifications(LocalPlayer.Character) end;
    table.insert(getgenv().LiquidConnections, LocalPlayer.CharacterAdded:Connect(SetupJumpModifications));
    
    -- Track shooting and reloading state
    local function TrackStates(Character)
        if not Character then return end;
        
        local function HookTool(Tool)
            if not Tool:IsA('Tool') then return end;
            
            -- Apply delay changer
            task.wait(0.1);
            ApplyDelayModification(Tool);
            
            table.insert(getgenv().LiquidConnections, Tool.Activated:Connect(function()
                State.IsShooting = true;
                task.delay(0.5, function()
                    State.IsShooting = false;
                end);
            end));
            
            -- Track reloading via Ammo
            local Ammo = Tool:FindFirstChild('Ammo');
            if Ammo then
                table.insert(getgenv().LiquidConnections, Ammo:GetPropertyChangedSignal('Value'):Connect(function()
                    if Ammo.Value == 0 then
                        State.IsReloading = true;
                        task.delay(2, function()
                            State.IsReloading = false;
                        end);
                    end;
                end));
            end;
            
            -- Track reloading via Reloading flag
            local Reloading = Tool:FindFirstChild('Reloading');
            if Reloading then
                table.insert(getgenv().LiquidConnections, Reloading:GetPropertyChangedSignal('Value'):Connect(function()
                    State.IsReloading = Reloading.Value;
                end));
            end;
        end;
        
        for _, Tool in next, Character:GetChildren() do
            if Tool:IsA('Tool') then HookTool(Tool) end;
        end;
        
        table.insert(getgenv().LiquidConnections, Character.ChildAdded:Connect(function(Child)
            if Child:IsA('Tool') then HookTool(Child) end;
        end));
        
        -- Also handle backpack tools
        local Backpack = LocalPlayer:FindFirstChild('Backpack');
        if Backpack then
            for _, Tool in next, Backpack:GetChildren() do
                if Tool:IsA('Tool') then 
                    task.wait(0.1);
                    ApplyDelayModification(Tool);
                end;
            end;
            table.insert(getgenv().LiquidConnections, Backpack.ChildAdded:Connect(function(Child)
                if Child:IsA('Tool') then 
                    task.wait(0.1);
                    ApplyDelayModification(Child);
                end;
            end));
        end;
        
        -- Track body effects reload
        task.wait(0.5);
        local BodyEffects = Character:FindFirstChild('BodyEffects');
        if BodyEffects then
            local Reload = BodyEffects:FindFirstChild('Reload');
            if Reload then
                table.insert(getgenv().LiquidConnections, Reload:GetPropertyChangedSignal('Value'):Connect(function()
                    State.IsReloading = Reload.Value;
                end));
            end;
        end;
    end;
    
    if LocalPlayer.Character then TrackStates(LocalPlayer.Character) end;
    table.insert(getgenv().LiquidConnections, LocalPlayer.CharacterAdded:Connect(TrackStates));
end;

