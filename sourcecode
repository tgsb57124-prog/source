local function UpdateDisplayBinds()
    local BindsCfg = Config['Settings']['Display Binds'];
    if not BindsCfg['Enabled'] then
        PanelTitle.Visible = false;
        for _, Label in next, PanelLabels do
            Label.Visible = false;
        end;
        return;
    end;
    
    local ViewportSize = Camera.ViewportSize;
    local CenterX = math.floor(ViewportSize.X / 2);
    local PanelPosition = BindsCfg['Position'] or 'Bottom';
    
    -- Collect all labels first
    local Labels = {};
    local KeyColor = BindsCfg['Key Color'];
    local TargetColor = BindsCfg['Target Color'];
    local HealthColor = BindsCfg['Health Color'];
    local ArmorColor = BindsCfg['Armor Color'];
    
    local function Rgb(C)
        return math.floor(C.R * 255 + 0.5), math.floor(C.G * 255 + 0.5), math.floor(C.B * 255 + 0.5);
    end;
    
    local Kr, Kg, Kb = Rgb(KeyColor);
    local Tr, Tg, Tb = Rgb(TargetColor);
    local Hr, Hg, Hb = Rgb(HealthColor);
    local Ar, Ag, Ab = Rgb(ArmorColor);
    
    -- Get current target (priority: Silent > Aim Assist)
    local CurrentTarget = (State.SilentLocked and State.SilentTarget) or (State.AimAssistEnabled and State.AimAssistTarget);
    
    -- Show target health and armor
    if CurrentTarget then
        local Character = CurrentTarget.Character;
        local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid');
        if Humanoid then
            local Health = Humanoid.Health;
            local MaxHealth = Humanoid.MaxHealth;
            local ArmorVal = GetHealthBarArmor(CurrentTarget);
            
            local HealthText = string.format(
                '<font color="rgb(%d,%d,%d)">health: %d/%d</font>',
                Hr, Hg, Hb, math.floor(Health), math.floor(MaxHealth)
            );
            local ArmorText = string.format(
                '<font color="rgb(%d,%d,%d)">armor: %d</font>',
                Ar, Ag, Ab, math.floor(ArmorVal)
            );
            table.insert(Labels, HealthText .. ' | ' .. ArmorText);
        end;
    end;
    
    -- Silent Aim
    if Config['Silent Aim']['Enabled'] and State.SilentLocked and State.SilentTarget then
        local TName = State.SilentTarget.DisplayName or State.SilentTarget.Name;
        table.insert(Labels, string.format(
            '<font color="rgb(%d,%d,%d)">silent aim: </font><font color="rgb(%d,%d,%d)">%s</font>',
            Kr, Kg, Kb, Tr, Tg, Tb, TName
        ));
    elseif Config['Silent Aim']['Enabled'] then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">silent aim: off</font>', Kr, Kg, Kb));
    end;
    
    -- Aim Assist
    if Config['Aim Assist']['Enabled'] and State.AimAssistEnabled and State.AimAssistTarget then
        local TName = State.AimAssistTarget.DisplayName or State.AimAssistTarget.Name;
        table.insert(Labels, string.format(
            '<font color="rgb(%d,%d,%d)">aim assist: </font><font color="rgb(%d,%d,%d)">%s</font>',
            Kr, Kg, Kb, Tr, Tg, Tb, TName
        ));
    elseif Config['Aim Assist']['Enabled'] and State.AimAssistEnabled then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">aim assist: off</font>', Kr, Kg, Kb));
    end;
    
    -- Trigger Bot
    if Config['Trigger Bot']['Enabled'] and State.TriggerBotEnabled and State.TriggerBotTarget then
        local TName = State.TriggerBotTarget.DisplayName or State.TriggerBotTarget.Name;
        table.insert(Labels, string.format(
            '<font color="rgb(%d,%d,%d)">trigger bot: </font><font color="rgb(%d,%d,%d)">%s</font>',
            Kr, Kg, Kb, Tr, Tg, Tb, TName
        ));
    elseif Config['Trigger Bot']['Enabled'] and State.TriggerBotEnabled then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">trigger bot: off</font>', Kr, Kg, Kb));
    end;
    
    -- Walk Speed
    if Config['Movement Modifications']['Enabled'] and State.WalkSpeedActive then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">walk speed: </font><font color="rgb(%d,%d,%d)">on</font>', Kr, Kg, Kb, Tr, Tg, Tb));
    end;
    
    -- Jump Power
    if Config['Jump Modifications']['Enabled'] and State.JumpModificationsActive then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">jump power: </font><font color="rgb(%d,%d,%d)">on</font>', Kr, Kg, Kb, Tr, Tg, Tb));
    end;
    
    -- ESP
    if Config['ESP']['Enabled'] and State.ESPEnabled then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">esp: </font><font color="rgb(%d,%d,%d)">on</font>', Kr, Kg, Kb, Tr, Tg, Tb));
    end;
    
    -- Das Hood Features
    if Config['Das Hood']['Inf Range']['Enabled'] then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">inf range: </font><font color="rgb(%d,%d,%d)">on</font>', Kr, Kg, Kb, Tr, Tg, Tb));
    end;
    
    if Config['Das Hood']['Wallbang']['Enabled'] then
        table.insert(Labels, string.format('<font color="rgb(%d,%d,%d)">wallbang: </font><font color="rgb(%d,%d,%d)">on</font>', Kr, Kg, Kb, Tr, Tg, Tb));
    end;
    
    -- Position the panel
    if PanelPosition == 'Top' then
        -- Top position: title at bottom of panel
        local BaseY = 20;
        local OffsetY = BaseY;
        
        -- Render labels first (top to bottom)
        for i = 1, #Labels do
            local L = PanelLabels[i];
            if L then
                L.Text = Labels[i];
                L.Position = UDim2.fromOffset(CenterX, OffsetY);
                L.Visible = true;
                OffsetY = OffsetY + 16;
            end;
        end;
        
        -- Title at bottom
        local TitleColor = BindsCfg['Title Color'];
        PanelTitle.Text = string.format(
            '<font color="rgb(%d,%d,%d)">%s</font>',
            math.floor(TitleColor.R * 255 + 0.5),
            math.floor(TitleColor.G * 255 + 0.5),
            math.floor(TitleColor.B * 255 + 0.5),
            BindsCfg['Title']
        );
        PanelTitle.Position = UDim2.fromOffset(CenterX, OffsetY);
        PanelTitle.Visible = true;
    else
        -- Bottom position: title at top (original layout)
        local BaseY = math.floor(ViewportSize.Y - 200);
        
        -- Title
        local TitleColor = BindsCfg['Title Color'];
        PanelTitle.Text = string.format(
            '<font color="rgb(%d,%d,%d)">%s</font>',
            math.floor(TitleColor.R * 255 + 0.5),
            math.floor(TitleColor.G * 255 + 0.5),
            math.floor(TitleColor.B * 255 + 0.5),
            BindsCfg['Title']
        );
        PanelTitle.Position = UDim2.fromOffset(CenterX, BaseY);
        PanelTitle.Visible = true;
        
        -- Labels below title
        local OffsetY = BaseY + 20;
        for i = 1, #Labels do
            local L = PanelLabels[i];
            if L then
                L.Text = Labels[i];
                L.Position = UDim2.fromOffset(CenterX, OffsetY);
                L.Visible = true;
                OffsetY = OffsetY + 16;
            end;
        end;
    end;
    
    -- Hide unused labels
    for i = #Labels + 1, #PanelLabels do
        PanelLabels[i].Visible = false;
    end;
end;

-- Keybinds
local function IsTyping()
    return UserInputService:GetFocusedTextBox() ~= nil;
end;

UserInputService.InputBegan:Connect(function(Input, Processed)
    if Processed or IsTyping() then return end;
    
    local Keybinds = Config['Settings']['Keybinds'];
    
    -- Check Silent Aim keybind (Toggle-lock)
    local SilentKey = Keybinds['Silent Aim'];
    if SilentKey then
        local Matched = false;
        pcall(function()
            if Input.KeyCode == Enum.KeyCode[SilentKey:upper()] then
                Matched = true;
            end;
        end);
        
        if Matched then
            if State.SilentLocked then
                -- Unlock
                State.SilentLocked = false;
                State.SilentTarget = nil;
            else
                -- Lock onto closest player
                State.SilentTarget = GetClosestPlayer();
                if State.SilentTarget then
                    State.SilentLocked = true;
                end;
            end;
        end;
    end;
    
    -- Check Aim Assist keybind
    local AimAssistKey = Keybinds['Aim Assist'];
    if AimAssistKey then
        local Matched = false;
        pcall(function()
            if Input.KeyCode == Enum.KeyCode[AimAssistKey:upper()] then
                Matched = true;
            end;
        end);
        
        if Matched then
            State.AimAssistEnabled = not State.AimAssistEnabled;
        end;
    end;
    
    -- Check Trigger Bot keybind
    local TriggerBotKey = Keybinds['Trigger Bot'];
    if TriggerBotKey then
        local Matched = false;
        pcall(function()
            if Input.KeyCode == Enum.KeyCode[TriggerBotKey:upper()] then
                Matched = true;
            end;
        end);
        
        if Matched then
            State.TriggerBotEnabled = not State.TriggerBotEnabled;
            State.LastAttackTime = 0;
        end;
    end;
    
    -- Check Speed keybind
    local SpeedKey = Keybinds['Walk Speed'];
    if SpeedKey then
        local Matched = false;
        pcall(function()
            if Input.KeyCode == Enum.KeyCode[SpeedKey:upper()] then
                Matched = true;
            end;
        end);
        
        if Matched then
            State.WalkSpeedActive = not State.WalkSpeedActive;
        end;
    end;
    
    -- Check Jump Power keybind
    local JumpKey = Keybinds['Jump Power'];
    if JumpKey then
        local Matched = false;
        pcall(function()
            if Input.KeyCode == Enum.KeyCode[JumpKey:upper()] then
                Matched = true;
            end;
        end);
        
        if Matched then
            State.JumpModificationsActive = not State.JumpModificationsActive;
        end;
    end;
    
    -- Check ESP keybind
    local ESPKey = Keybinds['ESP'];
    if ESPKey then
        local Matched = false;
        pcall(function()
            if Input.KeyCode == Enum.KeyCode[ESPKey:upper()] then
                Matched = true;
            end;
        end);
        
        if Matched then
            State.ESPEnabled = not State.ESPEnabled;
            Config['ESP']['Enabled'] = State.ESPEnabled;
        end;
    end;
    
    -- Check Panic Ground keybind
    local PanicGroundKey = Keybinds['Panic Ground'];
    if PanicGroundKey then
        local Matched = false;
        pcall(function()
            if Input.KeyCode == Enum.KeyCode[PanicGroundKey:upper()] then
                Matched = true;
            end;
        end);
        
        if Matched then
            RunPanicGround();
        end;
    end;
end);

-- Hitbox Expander
do
    local HitboxCfg = Config['Hitbox Expander'];
    if HitboxCfg then
        local function RestoreHitbox(HRP)
            if not HRP then return end;
            HRP.Size = Vector3New(2, 2, 1);
            HRP.Transparency = 1;
            HRP.Material = Enum.Material.Plastic;
            HRP.BrickColor = BrickColor.new('Medium stone grey');
        end;

        table.insert(getgenv().LiquidConnections, RunService.Heartbeat:Connect(function()
            local Cfg = Config['Hitbox Expander'];
            if not Cfg['Enabled'] then
                for _, Player in next, Players:GetPlayers() do
                    if Player == LocalPlayer then continue end;
                    local Character = Player.Character;
                    local HRP = Character and Character:FindFirstChild('HumanoidRootPart');
                    if HRP then
                        RestoreHitbox(HRP);
                    end;
                end;
                return;
            end;
            
            local Size = Cfg['Size'] or 15;
            local TargetOnly = Cfg['Target Only'];
            local Visualize = Cfg['Visualize'];
            
            -- Get current target from any active feature
            local CurrentTarget = TargetOnly and (State.SilentTarget or State.TriggerBotTarget or State.AimAssistTarget);
            
            for _, Player in next, Players:GetPlayers() do
                if Player == LocalPlayer then continue end;
                local Character = Player.Character;
                if not Character then continue end;
                
                local HRP = Character:FindFirstChild('HumanoidRootPart');
                if not HRP then continue end;
                
                if TargetOnly and CurrentTarget ~= Player then
                    RestoreHitbox(HRP);
                    continue;
                end;
                
                HRP.Size = Vector3New(Size, Size, Size);
                HRP.CanCollide = false;
                
                if Visualize then
                    HRP.Transparency = 0.5;
                    HRP.BrickColor = BrickColor.new('Really black');
                    HRP.Material = Enum.Material.SmoothPlastic;
                else
                    HRP.Transparency = 1;
                    HRP.Material = Enum.Material.Plastic;
                    HRP.BrickColor = BrickColor.new('Medium stone grey');
                end;
            end;
        end));
    end;
end;

-- Main Loop (with Death Freeze Prevention)
-- Main Loop - Ultra-fast ESP updates
RunService.RenderStepped:Connect(function()
    -- Always update ESP every frame for maximum smoothness
    UpdateESP();
    UpdateDisplayBinds();
    
    -- Death Freeze Fix: Check if local player is alive before updating aim features
    local Character = LocalPlayer.Character;
    if not Character then return end;
    
    local Humanoid = Character:FindFirstChildOfClass('Humanoid');
    if not Humanoid then return end;
    
    -- Skip aim updates if dead/knocked to prevent freeze
    local BodyEffects = Character:FindFirstChild('BodyEffects');
    if BodyEffects then
        local KO = BodyEffects:FindFirstChild('K.O');
        if KO and KO.Value == true then
            -- You're knocked, skip aim features but ESP still updates above
            return;
        end;
    end;
    
    -- Skip aim updates if humanoid is dead
    if Humanoid.Health <= 0 then
        return;
    end;
    
    -- Safe to run aim updates
    UpdateSilentTarget();
    ApplyAimAssist();
end);

-- Secondary loop for position cache (runs at physics rate for even more updates)
RunService.Heartbeat:Connect(function()
    UpdatePositionCache();
end);

-- Respawn Cleanup (prevents freeze on death/respawn)
table.insert(getgenv().LiquidConnections, LocalPlayer.CharacterAdded:Connect(function(Character)
    -- Clear targets on respawn
    State.SilentLocked = false;
    State.SilentTarget = nil;
    State.AimAssistTarget = nil;
    
    -- Wait for character to fully load
    task.wait(0.5);
    
    -- Clear position cache on respawn
    for Player in next, PositionCache do
        PositionCache[Player] = nil;
    end;
end));

