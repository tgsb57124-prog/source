-- Silent Aim Implementation - Multi-Method System
-- Priority Chain: 1) NameCall Hook, 2) __index Hook, 3) Mouse.Hit Override (fallback)
do
    local SilentAimActive = false;
    
    -- Method 1: Namecall Hook for MainEvent (BEST - modifies network arguments)
    local function SetupNamecallHook()
        local Success, Result = pcall(function()
            if not ReplicatedStorage then return false end;
            
            local MainEvent = ReplicatedStorage:FindFirstChild('MainEvent') or ReplicatedStorage:WaitForChild('MainEvent', 5);
            if not MainEvent then return false end;
            
            State.MainEvent = MainEvent;
            
            -- Store original for cleanup
            if not getgenv().LiquidOldNamecall then
                getgenv().LiquidOldNamecall = hookmetamethod(game, "__namecall", function(...) return getgenv().LiquidOldNamecall(...) end);
            end;
            
            local OldNamecall = getgenv().LiquidOldNamecall;
            
            hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                local Args = {...};
                local Method = getnamecallmethod();
                
                -- Intercept MainEvent:FireServer for shooting
                if self == State.MainEvent and Method == "FireServer" and not checkcaller() then
                    local SACfg = Config['Silent Aim'];
                    local Arg1 = Args[1];
                    
                    -- Check for shooting calls
                    local IsShootCall = (Arg1 == "UpdateMousePos" or Arg1 == "UpdateMousePosI" or Arg1 == "UpdateMousePosI2" or Arg1 == "ShootGun" or Arg1 == "MOUSE");
                    
                    if IsShootCall and SACfg and SACfg['Enabled'] and State.SilentLocked and State.SilentTarget then
                        local Target = State.SilentTarget;
                        
                        if Target and Target.Character and PassesChecks(Target) then
                            local Hitpart = Target.Character:FindFirstChild(SACfg['Hitpart']) or Target.Character:FindFirstChild('HumanoidRootPart');
                            
                            if Hitpart then
                                local TargetPos = ApplyPrediction(Hitpart.Position, Target);
                                
                                -- Modify different argument structures
                                if Arg1 == "UpdateMousePos" or Arg1 == "UpdateMousePosI" or Arg1 == "UpdateMousePosI2" or Arg1 == "MOUSE" then
                                    Args[2] = TargetPos;
                                elseif Arg1 == "ShootGun" then
                                    if Args[3] and typeof(Args[3]) == "Vector3" then
                                        Args[3] = TargetPos;
                                    end;
                                    if Args[5] and typeof(Args[5]) == "Vector3" then
                                        Args[5] = TargetPos;
                                    end;
                                end;
                            end;
                        end;
                    end;
                end;
                
                return OldNamecall(self, unpack(Args));
            end));
            
            return true;
        end);
        
        return Success and Result;
    end;
    
    -- Method 2: __index Hook (GOOD - intercepts property reads)
    local function SetupIndexHook()
        local Success = pcall(function()
            local Mt = getrawmetatable(game);
            
            -- Store original for cleanup
            if not getgenv().LiquidOldIndex then
                getgenv().LiquidOldIndex = Mt.__index;
            end;
            
            local OldIndex = getgenv().LiquidOldIndex;
            setreadonly(Mt, false);
            
            Mt.__index = newcclosure(function(self, key)
                if not checkcaller() and self == Mouse and (key == 'Hit' or key == 'Target') then
                    local SACfg = Config['Silent Aim'];
                    
                    if SACfg and SACfg['Enabled'] and State.SilentLocked and State.SilentTarget then
                        local Target = State.SilentTarget;
                        
                        if Target and Target.Character and PassesChecks(Target) then
                            local Hitpart = Target.Character:FindFirstChild(SACfg['Hitpart']) or Target.Character:FindFirstChild('HumanoidRootPart');
                            
                            if Hitpart then
                                local TargetPos = ApplyPrediction(Hitpart.Position, Target);
                                
                                if key == 'Hit' then
                                    return CFrameNew(TargetPos);
                                elseif key == 'Target' then
                                    return Hitpart;
                                end;
                            end;
                        end;
                    end;
                end;
                
                return OldIndex(self, key);
            end);
            
            setreadonly(Mt, true);
            return true;
        end);
        
        return Success;
    end;
    
    -- Try methods in priority order
    task.spawn(function()
        -- Try Namecall hook first (best method for this game)
        if SetupNamecallHook() then
            State.SilentMethod = "Namecall Hook";
            SilentAimActive = true;
        end;
        
        -- Try __index hook (works alongside namecall)
        task.wait(0.1);
        if SetupIndexHook() then
            State.SilentMethod = State.SilentMethod and (State.SilentMethod .. " + __index") or "__index Hook";
            SilentAimActive = true;
        end;
    end);
end;

-- Aim Assist Function
local function ApplyAimAssist()
    if not State.AimAssistEnabled then 
        State.AimAssistTarget = nil;
        return;
    end;
    
    local AimAssistCfg = Config['Aim Assist'];
    if not AimAssistCfg['Enabled'] then 
        State.AimAssistTarget = nil;
        return;
    end;
    
    local Target;
    
    -- Sticky aim: lock onto one target until invalid
    if State.AimAssistTarget then
        -- Check if current target is still valid
        if State.AimAssistTarget.Parent and PassesChecks(State.AimAssistTarget) and State.AimAssistTarget.Character then
            Target = State.AimAssistTarget; -- Keep current target
        else
            -- Current target is invalid, turn OFF aim assist (no auto re-target)
            State.AimAssistTarget = nil;
            State.AimAssistEnabled = false;
            return;
        end;
    else
        -- No current target, find closest
        Target = GetClosestPlayer();
        State.AimAssistTarget = Target;
    end;
    
    if not Target or not Target.Character then
        State.AimAssistTarget = nil;
        State.AimAssistEnabled = false;
        return;
    end;
    
    if not PassesChecks(Target) then 
        State.AimAssistTarget = nil;
        State.AimAssistEnabled = false;
        return;
    end;
    
    local TargetChar = Target.Character;
    local HRP = TargetChar:FindFirstChild('HumanoidRootPart');
    if not HRP then return end;
    
    -- Get hit position based on hitpart setting
    local Hitpart = TargetChar:FindFirstChild(AimAssistCfg['Hitpart']);
    if not Hitpart then
        Hitpart = HRP;
    end;
    
    local TargetPos = Hitpart.Position;
    
    -- Apply prediction if enabled
    if AimAssistCfg['Prediction']['Enabled'] then
        local Vel = GetVelocity(Target);
        if Vel.Magnitude >= 5 then
            local PredValues = AimAssistCfg['Prediction'];
            local PredPos = TargetPos + Vel * Vector3New(PredValues.X, PredValues.Y, PredValues.Z);
            
            -- Clamp prediction distance
            local MaxPredDist = 50;
            if (PredPos - TargetPos).Magnitude > MaxPredDist then
                PredPos = TargetPos + (PredPos - TargetPos).Unit * MaxPredDist;
            end;
            
            TargetPos = PredPos;
        end;
    end;
    
    local Sharpness = AimAssistCfg['Sharpness'] or 0.09;
    local CamPos = Camera.CFrame.Position;
    
    local DesiredCFrame = CFrameNew(CamPos, TargetPos);
    if Sharpness < 1 then
        local FromLook = Camera.CFrame.LookVector;
        local ToLook = (TargetPos - CamPos).Unit;
        local NewLook = (FromLook + (ToLook - FromLook) * MathClamp(Sharpness, 0, 1)).Unit;
        Camera.CFrame = CFrameNew(CamPos, CamPos + NewLook);
    else
        Camera.CFrame = DesiredCFrame;
    end;
end;

-- Trigger Bot (adapted from cidir new - core logic)
do
    local TriggerBotCfg = Config['Trigger Bot'];
    
    local function PerformTriggerAttack()
        if not TriggerBotCfg['Enabled'] then return end;
        if not State.TriggerBotEnabled then return end;
        
        local Target = State.TriggerBotTarget;
        if not Target or not IsAlive(Target) then
            State.TriggerBotTarget = nil;
            return;
        end;
        
        local TargetChar = Target.Character;
        if not TargetChar then return end;
        
        local Character = LocalPlayer.Character;
        if not Character then return end;
        
        local Tool = Character:FindFirstChildOfClass('Tool');
        if not Tool or not Tool:FindFirstChild('Ammo') or Tool.Name == '[Knife]' then return end;
        
        -- Check ammo before shooting to prevent blanking
        local Ammo = Tool:FindFirstChild('Ammo');
        if Ammo and Ammo.Value <= 0 then return end;
        
        local Humanoid = Character:FindFirstChild('Humanoid');
        if not Humanoid or Humanoid.Health <= 0 then return end;
        
        local BodyEffects = Character:FindFirstChild('BodyEffects');
        if BodyEffects then
            if BodyEffects:FindFirstChild('K.O') and BodyEffects['K.O'].Value then return end;
            if BodyEffects:FindFirstChild('Reload') and BodyEffects.Reload.Value then return end;
            if BodyEffects:FindFirstChild('Dead') and BodyEffects.Dead.Value then return end;
        end;
        
        -- Check if weapon is in allowed list
        local Weapons = TriggerBotCfg['Weapons'];
        if Weapons and next(Weapons) then
            local WeaponValid = false;
            for WeaponName, Enabled in pairs(Weapons) do
                if Enabled and Tool.Name == WeaponName then
                    WeaponValid = true;
                    break;
                end;
            end;
            if not WeaponValid then return end;
        end;
        
        local SelfHRP = Character:FindFirstChild('HumanoidRootPart');
        local TargetHRP = TargetChar:FindFirstChild('HumanoidRootPart');
        if not SelfHRP or not TargetHRP then return end;
        
        -- Distance check
        local TargetDist = (SelfHRP.Position - TargetHRP.Position).Magnitude;
        local TrigMaxRange = TriggerBotCfg['Max Distance'] or math.huge;
        if TargetDist > TrigMaxRange then return end;
        
        -- FOV check (cidir style)
        local ViewportY = Camera.ViewportSize.Y;
        local CamFOV = Camera.FieldOfView;
        local AimPos = TargetHRP.Position;
        
        local ScreenPos, OnScreen = Camera:WorldToViewportPoint(AimPos);
        if not OnScreen then return end;
        
        local HitCheck = TriggerBotCfg['Mode'] or 'FOV';
        local ShouldFire = false;
        
        if HitCheck == 'Hitbox' then
            local MouseTarget = Mouse.Target;
            ShouldFire = MouseTarget and MouseTarget:IsDescendantOf(TargetChar);
        else
            -- FOV mode
            local MouseLoc = UserInputService:GetMouseLocation();
            local Delta = Vector2New(ScreenPos.X, ScreenPos.Y) - MouseLoc;
            local Depth = ScreenPos.Z;
            if Depth > 1 then
                local ScaleFactor = (TargetHRP.Size.Y * ViewportY) / (Depth * 2) * 80 / CamFOV;
                local ScaledW = 9e9 * ScaleFactor;
                local ScaledH = 9e9 * ScaleFactor;
                ShouldFire = (math.abs(Delta.X) <= ScaledW / 2 and math.abs(Delta.Y) <= ScaledH / 2);
            end;
        end;
        
        if ShouldFire then
            local CurrentTime = Clock();
            -- Increased delay to prevent blanking (was 0.002, now 0.05 for slightly slower but more reliable)
            local MinDelay = math.max(TriggerBotCfg['Delay Interval'] or 0.05, 0.05);
            
            if CurrentTime - State.LastAttackTime >= MinDelay then
                -- Double check ammo right before shooting
                if Ammo and Ammo.Value > 0 then
                    State.IsShooting = true;
                    Tool:Activate();
                    State.LastAttackTime = CurrentTime;
                    task.delay(0.1, function()
                        State.IsShooting = false;
                    end);
                end;
            end;
        end;
    end;
    
    -- Update trigger bot target (runs in PreRender like cidir)
    table.insert(getgenv().LiquidConnections, RunService.PreRender:Connect(function()
        if not TriggerBotCfg['Enabled'] or not State.TriggerBotEnabled then
            State.TriggerBotTarget = nil;
            return;
        end;
        
        -- Check if current target is still valid
        if State.TriggerBotTarget then
            if State.SilentLocked and State.SilentTarget and IsAlive(State.SilentTarget) then
                -- Use silent aim target if locked
                State.TriggerBotTarget = State.SilentTarget;
            elseif not IsAlive(State.TriggerBotTarget) then
                -- Target died/invalid, turn OFF trigger bot (no auto re-target)
                State.TriggerBotTarget = nil;
                State.TriggerBotEnabled = false;
                return;
            end;
        else
            -- No target yet, find one (first time only)
            if State.SilentLocked and State.SilentTarget and IsAlive(State.SilentTarget) then
                State.TriggerBotTarget = State.SilentTarget;
            else
                State.TriggerBotTarget = GetClosestPlayer();
            end;
            
            -- If no target found, turn off
            if not State.TriggerBotTarget then
                State.TriggerBotEnabled = false;
                return;
            end;
        end;
        
        PerformTriggerAttack();
    end));
end;

