local NameESPLabels = {};

-- Armor helper function for display binds
local function GetHealthBarArmor(Player)
    if not Player then return 0 end;
    local Character = Player.Character;
    if not Character then return 0 end;
    
    local BodyEffects = Character:FindFirstChild('BodyEffects');
    if BodyEffects then
        local Armor = BodyEffects:FindFirstChild('Armor') or BodyEffects:FindFirstChild('Armour') or BodyEffects:FindFirstChild('Defense');
        if Armor and tonumber(Armor.Value) then
            return tonumber(Armor.Value);
        end;
    end;
    
    local Leaderstats = Player:FindFirstChild('leaderstats');
    if Leaderstats then
        local Armor = Leaderstats:FindFirstChild('Armor') or Leaderstats:FindFirstChild('Armour') or Leaderstats:FindFirstChild('Defense') or Leaderstats:FindFirstChild('Vest');
        if Armor and tonumber(Armor.Value) then
            return tonumber(Armor.Value);
        end;
    end;
    
    return 0;
end;

local function UpdateESP()
    -- Safely get ESP config
    if not Config or not Config['ESP'] then return end;
    local ESPCfg = Config['ESP'];
    
    if not ESPCfg['Enabled'] then
        for _, Label in pairs(NameESPLabels) do
            if Label then
                Label.Visible = false;
            end;
        end;
        return;
    end;
    
    local NameCfg = ESPCfg['Name'];
    if not NameCfg then return end;
    
    for _, Player in ipairs(Players:GetPlayers()) do
        if Player == LocalPlayer then continue end;
        
        local Character = Player.Character;
        if not Character then
            if NameESPLabels[Player] then
                NameESPLabels[Player].Visible = false;
            end;
            continue;
        end;
        
        local HRP = Character:FindFirstChild('HumanoidRootPart');
        local Head = Character:FindFirstChild('Head');
        local Humanoid = Character:FindFirstChildOfClass('Humanoid');
        
        if not HRP or not Humanoid or Humanoid.Health <= 0 then
            if NameESPLabels[Player] then
                NameESPLabels[Player].Visible = false;
            end;
            continue;
        end;
        
        -- Name ESP
        if NameCfg['Enabled'] then
            if not NameESPLabels[Player] then
                NameESPLabels[Player] = CreateTextLabel();
            end;
            
            local Label = NameESPLabels[Player];
            if not Label then continue end;
            
            local NamePosition = NameCfg['Position'] or 'Bottom';
            local Part = (NamePosition == 'Bottom') and HRP or Head;
            
            if Part then
                local Offset = (NamePosition == 'Bottom') and Vector3New(0, -3.5, 0) or Vector3New(0, 1.5, 0);
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(Part.Position + Offset);
                
                if OnScreen and ScreenPos.Z > 0 then
                    local IsTarget = (State.SilentTarget == Player or State.AimAssistTarget == Player);
                    Label.Text = Player.DisplayName or Player.Name;
                    Label.Position = UDim2.fromOffset(ScreenPos.X, ScreenPos.Y);
                    Label.TextColor3 = IsTarget and (NameCfg['Target Color'] or Color3.fromRGB(137, 243, 54)) or (NameCfg['Normal Color'] or Color3.fromRGB(255, 255, 255));
                    Label.Visible = true;
                else
                    Label.Visible = false;
                end;
            else
                Label.Visible = false;
            end;
        else
            if NameESPLabels[Player] then
                NameESPLabels[Player].Visible = false;
            end;
        end;
    end;
end;

